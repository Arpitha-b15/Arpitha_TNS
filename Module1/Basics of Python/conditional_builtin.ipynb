        "\n",
        "length = len(name)\n",
        "\n",
        "if length < 5:\n",
        "    print(\"Short Name\")\n",
        "\n",
        "elif length <= 10:\n",
        "    print(\"Medium Name\")\n",
        "\n",
        "else:\n",
        "    print(\"Long Name\")\n",
        "\n",
        "print(\"Length =\", length)\n",
        "print(\"Uppercase =\", name.upper())"
